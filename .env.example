# Server Configuration
PORT=5001
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5001

# PostgreSQL Database URL
DATABASE_URL="postgresql://orderblock:orderblock_dev_password@localhost:5432/payflow?schema=public"

# Authentication & Session Security
JWT_SECRET=super_secret_jwt_key_for_payflow_development_only_min_32_chars
SESSION_SECRET=super_secret_session_key_for_payflow_development_only_min_32_chars

# PayPal REST API Sandbox Credentials
# Register at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_registered_paypal_webhook_id
